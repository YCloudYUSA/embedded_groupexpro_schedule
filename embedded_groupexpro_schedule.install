<?php

/**
 * @file
 * Embedded GroupEx Pro Schedule extension install file.
 */

/**
 * Implements hook_update_last_removed().
 */
function embedded_groupexpro_schedule_update_last_removed() {
  return 8002;
}

/**
 * Store the GroupEx Pro account as an integer.
 */
function embedded_groupexpro_schedule_update_10001() {
  $config = \Drupal::configFactory()->getEditable('embedded_groupexpro_schedule.settings');
  $stored = $config->get('account');
  $account = embedded_groupexpro_schedule_account_from_string((string) $stored);
  $config->set('account', $account)->save();

  if ($account || $stored === NULL || $stored === '') {
    return NULL;
  }
  return t('The stored GroupEx Pro account was not a number and has been cleared. Set it again at /admin/openy/integrations/groupex-pro/groupexpro.');
}

/**
 * Returns the account id when the value holds only digits, 0 otherwise.
 */
function embedded_groupexpro_schedule_account_from_string(string $value): int {
  $value = trim($value);
  if (ctype_digit($value)) {
    return (int) $value;
  }
  return 0;
}
